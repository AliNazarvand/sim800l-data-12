{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dat_15 - Power Management DB (single record)",
  "type": "object",
  "required": ["_meta","mode_id","mode_name","description_fa","current_consumption_typical","current_consumption_max","unit","entry_condition","exit_condition","related_pins"],
  "properties": {
    "_meta": {
  "type": "object",
  "required": ["id","source","source_version","source_page","source_section","source_figure_number","extracted_at","pending_fields","compatible_models","missing_reason","completion_source","license_note"],
  "properties": {
    "id": { "type": "string" },
    "source": { "type": "string", "enum": ["SIM800L_Hardware_Design_V1.00","SIM800H&SIM800L_Hardware_Design_V2.02"] },
    "source_version": { "type": "string", "enum": ["V1.00","V2.02"] },
    "source_page": { "type": ["integer","null"] },
    "source_section": { "type": ["string","null"] },
    "source_figure_number": { "type": ["string","null"] },
    "extracted_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "pending_fields": { "type": "array", "items": { "type": "string" } },
    "compatible_models": { "type": "array", "items": { "type": "string", "enum": ["SIM800L","SIM800H"] }, "minItems": 1 },
    "missing_reason": { "type": ["string","null"], "enum": [null,"NOT_FOUND_IN_SOURCES","DEFERRED_TO_PHASE_2A","DEFERRED_TO_PHASE_2B","CONFLICTING_SOURCES","MIXED"] },
    "completion_source": { "type": ["string","null"] },
    "license_note": { "type": "string" },
    "deprecated_in": { "type": ["string","null"] }
  },
  "additionalProperties": false
},
    "mode_id": { "type": "string" },
    "mode_name": { "type": "string" },
    "description_fa": { "type": ["string","null"] },
    "current_consumption_typical": { "type": ["number","null"] },
    "current_consumption_max": { "type": ["number","null"] },
    "unit": { "type": "string" },
    "entry_condition": { "type": "string" },
    "exit_condition": { "type": "string" },
    "related_pins": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}